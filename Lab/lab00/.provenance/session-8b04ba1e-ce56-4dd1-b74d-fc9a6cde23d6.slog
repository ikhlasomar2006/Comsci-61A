{"data":{"content":"\"\"\"Lab 0: Getting Started.\"\"\"\n\n\ndef twenty_twenty_six():\n    \"\"\"Come up with the most creative expression that evaluates to 2026\n    using only numbers and the +, *, and - operators (or ** and % if you'd like).\n\n    >>> twenty_twenty_six()\n    2026\n    \"\"\"\n    return ______\n","line_count":12,"path":"lab00.py","sha256":"82335c78fdc41b72cd75854bed2d2c73647bf57f119f2b813ac37007375bd49b"},"hash":"14e2849cb0a61715a14c95060e06de6c55ec2aaf71678c9866974e6cd5ced68d","kind":"doc.open","prev_hash":"5fcfdf3162123e42b6bce67ce482656ea6efde7ce57a16482fa3c704934e3100","seq":20,"t":52553,"wall":"2026-08-30T17:05:12.464Z"}
