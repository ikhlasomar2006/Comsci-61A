{"data":{"content":"def ten_pairs(n):\n    \"\"\"Return the number of ten-pairs within positive integer n.\n\n    >>> ten_pairs(7823952) # 7+3, 8+2, and 8+2\n    3\n    >>> ten_pairs(55055)\n    6\n    >>> ten_pairs(9641469) # 9+1, 6+4, 6+4, 4+6, 1+9, 4+6\n    6\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n\n\ndef count_digit(n, digit):\n    \"\"\"Return how many times digit appears in n.\n\n    >>> count_digit(55055, 5) # digit 5 appears 4 times in 55055\n    4\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"","length":455,"path":"lab03.py","range":{"end":{"character":0,"line":117},"start":{"character":0,"line":117}},"sha256":"cbe5ede1e61f92880b53c8eb98425ca16a23f98e0420972ac612097d84282049"},"hash":"6429e4bd07ed430f26fb4db7138c127a0ad6cf855169f64ae1127de74fc6cf68","kind":"paste","prev_hash":"91669c64aa4ca74dc07ecee2ee1e3d574c0467e79a8d6d4597570ad9e762f4fe","seq":6196,"t":8136913,"wall":"2026-10-07T22:38:01.375Z"}
