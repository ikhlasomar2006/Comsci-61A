{"data":{"content":"\"\"\"Lab 1: Functions & Control.\"\"\"\n\n\ndef pick_digit(n, k):\n    \"\"\"Return the k-th digit from the right of n.\n\n    >>> pick_digit(3579, 2)\n    5\n    >>> pick_digit(3579, 0)\n    9\n    >>> pick_digit(3579, 10)\n    0\n    \"\"\"\n    return n // pow(10, k) - (n // pow(10, k + 1)) * 10\n\n\ndef middle(a, b, c):\n    \"\"\"Return the number among a, b, and c that is not the smallest or largest.\n    Assume a, b, and c are all different numbers.\n\n    >>> middle(3, 5, 4)\n    4\n    >>> middle(30, 5, 4)\n    5\n    >>> middle(3, 5, 40)\n    5\n    >>> middle(30, 5, 40)\n    30\n    \"\"\"\n    return a + b + c - max(a, b, c) - min(a, b, c)\n\n\ndef falling(n, k):\n    \"\"\"Compute the falling factorial of n to depth k.\n\n    >>> falling(6, 3)  # 6 * 5 * 4\n    120\n    >>> falling(4, 3)  # 4 * 3 * 2\n    24\n    >>> falling(4, 1)  # 4\n    4\n    >>> falling(4, 0)\n    1\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n    calc = n\n    while k != 1:\n        if(k == 0):\n            return 1\n        n -= 1\n        calc = calc * (n)\n        k -= 1\n    return calc\n\n\ndef divisible_by_k(n, k):\n    \"\"\"Print all positive integers up to n that are divisible by k from smallest\n    to largest, then return how many numbers were printed.\n\n    >>> a = divisible_by_k(10, 2)  # 2, 4, 6, 8, and 10 are divisible by 2\n    2\n    4\n    6\n    8\n    10\n    >>> a\n    5\n    >>> b = divisible_by_k(3, 1)  # 1, 2, and 3 are divisible by 1\n    1\n    2\n    3\n    >>> b\n    3\n    >>> c = divisible_by_k(6, 7)  # There are no integers up to 6 that are divisible by 7\n    >>> c\n    0\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n    count = 0\n    pointer = 1\n    while pointer != (n + 1):\n        if pointer % k == 0:\n            print(pointer)\n            count += 1\n        elif k == 0:\n            return \"Not Divisible\"\n        pointer += 1\n        \n    return count\n        \n\n\ndef double_eights(n):\n    \"\"\"Return true if n has two eights in a row.\n    >>> double_eights(8)\n    False\n    >>> double_eights(88)\n    True\n    >>> double_eights(2882)\n    True\n    >>> double_eights(880088)\n    True\n    >>> double_eights(12345)\n    False\n    >>> double_eights(80808080)\n    False\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n    k = 0\n    count = 0\n    while n // pow(10, k) != 0:        \n        if (n // pow(10, k) - (n // pow(10, k + 1)) * 10) == 8:\n            count += 1\n        else:\n            count = 0\n        k += 1\n        if count == 2:\n            return True\n        \n    return False\n    \n\n\n\ndef sum_digits(y):\n    \"\"\"Sum all the digits of y.\n\n    >>> sum_digits(10) # 1 + 0 = 1\n    1\n    >>> sum_digits(4224) # 4 + 2 + 2 + 4 = 12\n    12\n    >>> sum_digits(1234567890)\n    45\n    >>> a = sum_digits(123) # make sure that you are using return rather than print\n    >>> a\n    6\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n    num = 0\n    count = 0\n    while y // pow(10, num) != 0:\n        count += y // pow(10, num) - (y // pow(10, num + 1)) * 10\n        num += 1\n    return count","line_count":144,"path":"lab01.py","sha256":"d7450138e53b54e6f1fa94f96e16d21f64d71ddd4bc8d5977993fb5f088dffa4"},"hash":"2dbb5ba94b78ceff1be9aa4b2570dffe896c2d69ccec4dfd8ca666ce8f4c3767","kind":"doc.open","prev_hash":"03f767bf3394fc1bd29d80e6d96a9a1c8a631d1dd91088eebeb77c4c633d2b58","seq":547,"t":59548936,"wall":"2026-09-09T18:27:06.385Z"}
