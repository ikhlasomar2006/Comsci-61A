{"data":{"content":"    def helper(tree: Tree):     \n        value1 = 0\n        value2 = 0\n        for i in tree.branches:\n            if i.label:\n                return i.label\n            value1 += helper(i)\n            value2 = helper(i)\n\n        return value1 if value1 > value2 else value2\n\n    y = t.label + helper(t)\n    return y if y > t.label else t.label","length":344,"path":"hw04.py","range":{"end":{"character":0,"line":224},"start":{"character":0,"line":224}},"sha256":"2884ce19b9d1b115d66a824721ece562c36401d28765da2eaaa19e64fa1a1e8a"},"hash":"6878adf97fdabfc1ed53538dd283fd4e76e83c7c91578cffe0cf9ba95ced77bf","kind":"paste","prev_hash":"81d76d1782448eb9bc7ca3c17eb4d850e629b3a0118f99e9972b0fe3d291b9cb","seq":1230,"t":15007834,"wall":"2026-10-07T05:14:56.068Z"}
