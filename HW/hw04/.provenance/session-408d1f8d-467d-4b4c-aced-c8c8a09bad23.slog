{"data":{"deltas":[{"range":{"end":{"character":54,"line":106},"start":{"character":0,"line":93}},"text":"    \"\"\"Interleave linked lists s and t to produce a new linked list.\n\n    >>> evens = Link(2, Link(4, Link(6, Link(8))))\n    >>> odds = Link(1, Link(3))\n    >>> print(interleave(odds, evens))\n    (1 2 3 4 6 8)\n    >>> print(interleave(evens, odds))\n    (2 1 4 3 6 8)\n    >>> print(interleave(odds, odds))\n    (1 1 3 3)\n    >>> print(interleave((), odds))\n    (1 3)\n    >>> print(Link(evens, Link(odds)))  # should not change\n    ((2 4 6 8) (1 3))\n    \"\"\""}],"path":"hw04.py","source":"paste_likely"},"hash":"7c1ce6fe285e0be9638ff4d4851fb6a077a10edb55cedaf83f8f7f20ef6f6a15","kind":"doc.change","prev_hash":"71935589226b17f3e7c2ca58c7c2f500c7d659d970e89621c106ba70412625a6","seq":4109,"t":17433666,"wall":"2026-10-07T05:55:21.900Z"}
