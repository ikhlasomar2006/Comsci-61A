{"data":{"content":"    if isinstance(m, Planet):          # base case: a planet is always balanced\n        return True\n\n    left_torque = m.left.length * total_mass(m.left.end)\n    right_torque = m.right.length * total_mass(m.right.end)\n\n    return (left_torque == right_torque\n            and balanced(m.left.end)\n            and balanced(m.right.end))","length":334,"path":"hw04.py","range":{"end":{"character":0,"line":82},"start":{"character":0,"line":82}},"sha256":"4b1e8b7b962a35bb133741d99f2d3daad6002d275659b9d150391031ac107265"},"hash":"06e044d020c520c12c24663075cddbb717eaa6b7fb095ff8178a170bde2e93bd","kind":"paste","prev_hash":"5283ed7c142d3c82edd0468fd4691b58070f0f5612a140bd1a4fcbdad92958df","seq":5176,"t":63101865,"wall":"2026-10-05T17:55:15.965Z"}
