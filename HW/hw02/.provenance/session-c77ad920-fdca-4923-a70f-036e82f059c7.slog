{"data":{"deltas":[{"range":{"end":{"character":1,"line":172},"start":{"character":0,"line":172}},"text":"def add_church(m, n):\n    \"\"\"Return the Church numeral for m + n, for Church numerals m and n.\n\n    >>> church_to_int(add_church(two, three))\n    5\n    \"\"\"\n    \"*** YOUR CODE HERE ***\"\n    return m(lambda x: x + 1)(0) + n(lambda x: x + 1)(0) - 2"}],"path":"hw02.py","source":"paste_likely"},"hash":"c1351334b5d16750bbf48b428b978295ab856c2a4948bdc4cb01c630d32573d0","kind":"doc.change","prev_hash":"603b43d7687fda4076713a019ed39a767b288ed09c0094fd157d31b32cdeadea","seq":3450,"t":85085073,"wall":"2026-09-10T18:07:17.790Z"}
