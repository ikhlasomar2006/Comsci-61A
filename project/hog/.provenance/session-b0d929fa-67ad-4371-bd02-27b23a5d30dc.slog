","version":"10.0.0"},{"enabled":false,"id":"vscode.java","version":"10.0.0"},{"enabled":false,"id":"vscode.javascript","version":"10.0.0"},{"enabled":false,"id":"vscode.json","version":"10.0.0"},{"enabled":false,"id":"vscode.json-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.julia","version":"10.0.0"},{"enabled":false,"id":"vscode.latex","version":"10.0.0"},{"enabled":false,"id":"vscode.less","version":"10.0.0"},{"enabled":false,"id":"vscode.log","version":"10.0.0"},{"enabled":false,"id":"vscode.lua","version":"10.0.0"},{"enabled":false,"id":"vscode.make","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown","version":"30.0.0"},{"enabled":false,"id":"vscode.markdown-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown-math","version":"10.0.0"},{"enabled":false,"id":"vscode.media-preview","version":"10.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"10.0.0"},{"enabled":false,"id":"vscode.mermaid-markdown-features","version":"10.0.0"},{"enabled":false,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.117.0"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.11"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"10.0.0"},{"enabled":false,"id":"vscode.npm","version":"10.0.0"},{"enabled":false,"id":"vscode.objective-c","version":"10.0.0"},{"enabled":false,"id":"vscode.perl","version":"10.0.0"},{"enabled":false,"id":"vscode.php","version":"10.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.powershell","version":"10.0.0"},{"enabled":false,"id":"vscode.prompt","version":"10.0.0"},{"enabled":false,"id":"vscode.pug","version":"10.0.0"},{"enabled":false,"id":"vscode.python","version":"10.0.0"},{"enabled":false,"id":"vscode.r","version":"10.0.0"},{"enabled":false,"id":"vscode.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":false,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4