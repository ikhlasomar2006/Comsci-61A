{"data":{"deltas":[{"range":{"end":{"character":15,"line":197},"start":{"character":2,"line":186}},"text":"def autocorrect(typed_word, word_list, diff_function, limit):\n    if typed_word in word_list:\n        return typed_word\n\n    if word_list == []:\n        return typed_word\n\n    word_count = len(word_list) - 1\n    word = word_list[0]\n\n    for i in range(word_count):\n        if diff_function(word, typed_word, limit) > diff_function(word_list[i + 1], typed_word, limit):\n            word = word_list[i + 1]\n\n    if diff_function(word, typed_word, limit) > limit:\n        return typed_word\n\n    return word"}],"path":"cats.py","source":"paste_likely"},"hash":"e27759164f0d060d744fc75a815199f631bcd83a27ee8822a6663cd8bbe06747","kind":"doc.change","prev_hash":"30850cc402c56f465fb58b12dbeb3497f36cacb816612b34fe22ac1b1d2235b8","seq":6848,"t":42044717,"wall":"2026-09-30T05:29:30.825Z"}
