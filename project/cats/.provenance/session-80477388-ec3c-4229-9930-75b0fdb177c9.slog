{"data":{"deltas":[{"range":{"end":{"character":35,"line":236},"start":{"character":0,"line":208}},"text":"def furry_fixes(typed, source, limit):\n    if limit < 0:                       # already over the limit, stop early\n        return 0\n    if not typed or not source:         # one word ran out: the rest is the length difference\n        return abs(len(typed) - len(source))\n    cost = typed[0] != source[0]        # True/False acts as 1/0\n    return cost + furry_fixes(typed[1:], source[1:], limit - cost)"}],"path":"cats.py","source":"paste_likely"},"hash":"eedb2073a75d4675247380f5cb4179c67b969311cc6cf91e80cea152f6d6fa25","kind":"doc.change","prev_hash":"e22c6ed0b5b308d32f799fc416abd8cfca5332f72c8bc8d94ecfa3413c1fc466","seq":120,"t":10573435,"wall":"2026-10-02T06:10:50.403Z"}
