{"data":{"content":"    if limit < 0:\n        return 0\n\n    if typed == source:\n        return 0\n\n    if typed == \"\":\n        return len(source)\n\n    if source == \"\":\n        return len(typed)\n\n    if typed[0] == source[0]:\n        return minimum_mewtations(typed[1:], source[1:], limit)\n\n    add = minimum_mewtations(typed, source[1:], limit - 1)\n    remove = minimum_mewtations(typed[1:], source, limit - 1)\n    substitute = minimum_mewtations(typed[1:], source[1:], limit - 1)\n\n    return 1 + min(add, remove, substitute)","length":504,"path":"cats.py","range":{"end":{"character":0,"line":256},"start":{"character":0,"line":256}},"sha256":"7b307f719f848238213a37dff6bdd8f9feff3225c7350baa16f4d51d105eaa99"},"hash":"e702cda5255438868b9b857e82782903e334cb303f4a6bbc703042a0219f005e","kind":"paste","prev_hash":"ec6eede78c00faf08b41d4806044743d311c5b060417a6bc4dc0d6c47b9e6849","seq":626,"t":656617,"wall":"2026-10-02T01:46:32.321Z"}
