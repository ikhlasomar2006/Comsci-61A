{"data":{"deltas":[{"range":{"end":{"character":24,"line":394},"start":{"character":0,"line":383}},"text":"    words = words_and_times[\"words\"]\n    times = words_and_times[\"times\"]\n    per_word_time = [[] for _ in range(len(times))]\n    for i in range(len(words)):                # each word\n        fastest_time = float('inf')\n        fastest_player = 0\n        for j in range(len(times)):            # each player\n            if times[j][i] < fastest_time:     # strict <, so ties keep the earlier player\n                fastest_time = times[j][i]\n                fastest_player = j\n        per_word_time[fastest_player].append(words[i])\n    return per_word_time"}],"path":"cats.py","source":"paste_likely"},"hash":"4b5bd8c4701c5e3119c4390d3723c1150ecc5a962c6f9eeacb0588229d12bc03","kind":"doc.change","prev_hash":"7c2eecb6f9e133cfdb548793bc5776e8b7113ecd990d5e92c64e1529620f5699","seq":3083,"t":5385283,"wall":"2026-10-02T03:05:20.987Z"}
